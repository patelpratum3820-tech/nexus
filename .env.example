# =====================================================================
# NEXUS Environment Configuration (Template / Example)
# =====================================================================
# NEXUS is designed to run completely local-first.
# No third-party cloud API keys, tokens, or external credentials are required.
# Copy this file to .env for local overrides if modifying service ports.

# Backend Service Bindings (Strictly Localhost)
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8765

# Local Ollama Inference Engine Endpoint (Must remain localhost)
OLLAMA_ENDPOINT=http://127.0.0.1:11434

# Environment Mode: development | test | production
NEXUS_ENV=development

# Hardware Resource Admission Thresholds (Stricter overrides permitted)
# Maximum CPU utilization percentage before task admission is rejected (Hard limit: 80.0%)
MAX_SAFE_CPU_PERCENT=80.0

# Minimum available system RAM reserve in GB (Hard boundary: 2.0 GB)
MIN_SAFE_AVAILABLE_RAM_GB=2.0
