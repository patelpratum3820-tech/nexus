# =====================================================================
# NEXUS Root .gitignore
# Professional gitignore protecting user privacy, secrets, and binaries
# =====================================================================

# Environment & Secret files (NEVER commit secrets or tokens)
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.pfx

# Dependencies
node_modules/
.venv/
venv/
env/
ENV/

# Build & Bundling Outputs
frontend/dist/
desktop/dist/
build/
dist/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.spec

# Database Files, WAL, and Local Storage
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
*.sqlite3

# Logs & Runtime Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo

# Ollama Local Binaries & Model Runner Executables
olama/
*.exe
*.dll
*.dylib
*.so
